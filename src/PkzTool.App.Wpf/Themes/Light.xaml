<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Window" Color="#FFF4F5F7" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Control" Color="#FFECEDF0" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#FFE1E3E8" />
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#FFD3D6DC" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FFDEE1E6" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FFC7CBD1" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FF1F2329" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#FF6B7280" />
    <SolidColorBrush x:Key="Brush.Heading" Color="#FF111827" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF3B82F6" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Viewer" Color="#FFE9EAED" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FFEAF6EE" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF2F7D46" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFDECEC" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFB42318" />
    <SolidColorBrush x:Key="Brush.Status" Color="#FFECEDF0" />

    <DrawingBrush x:Key="Brush.Checkerboard" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFFFF" Geometry="M0,0 H16 V16 H0 Z" />
                <GeometryDrawing Brush="#FFE3E4E8" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
