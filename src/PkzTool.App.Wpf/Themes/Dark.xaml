<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Window" Color="#FF1B1C1F" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FF24262A" />
    <SolidColorBrush x:Key="Brush.Control" Color="#FF2A2C31" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#FF34373D" />
    <SolidColorBrush x:Key="Brush.ControlPressed" Color="#FF3D4148" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FF2B2D32" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF3A3D43" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF454952" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFE6E8EC" />
    <SolidColorBrush x:Key="Brush.Muted" Color="#FF9AA0AA" />
    <SolidColorBrush x:Key="Brush.Heading" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF4F8DF7" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Viewer" Color="#FF141519" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF1E3326" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF7BD88F" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FF3A2224" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFF19A9A" />
    <SolidColorBrush x:Key="Brush.Status" Color="#FF212327" />

    <DrawingBrush x:Key="Brush.Checkerboard" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FF212125" Geometry="M0,0 H16 V16 H0 Z" />
                <GeometryDrawing Brush="#FF191A1D" Geometry="M0,0 H8 V8 H0 Z M8,8 H16 V16 H8 Z" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
