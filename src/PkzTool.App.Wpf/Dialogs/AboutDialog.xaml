<dialogs:ThemedDialog x:Class="PkzTool.App.Wpf.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:PkzTool.App.Wpf.Dialogs"
        Title="About" Width="560" Height="470"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Window}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource Brush.Control}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource IconText}" FontSize="22" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Text="&#xE8B7;" />
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="PKZ Explorer" Style="{StaticResource DialogTitle}" />
                <TextBlock x:Name="Subtitle" Foreground="{DynamicResource Brush.Muted}" Margin="0,3,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Style="{StaticResource DialogHint}" Margin="0,14,0,0"
                   Text="A pkz archive explorer and editor for Bayonetta 3. Several archives are presented as one virtual filesystem; every edit is staged in memory until you save." />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel Margin="14,12">
                        <TextBlock Text="Format" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                                   Text="A 0x20 header ('pkzl', version 0x00020000), a 0x20-byte entry table, a shared string area, then data aligned to 64 bytes. Names are stored in the archive, so entries are addressed by their path (pl/pl0000.dat) with no hash lookup. Compression is per entry: None, ZStandard or Oodle Kraken." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel Margin="14,12">
                        <TextBlock Text="The compression rule" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                                   Text="After compressing a file, if the result is 90% or more of the original size the file is stored uncompressed instead. This overrides the type you picked, for that file only, so a requested compression can never make an archive bigger. In the CLI, --force-compression skips the rule." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel Margin="14,12">
                        <TextBlock Text="Session" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="SessionText" Style="{StaticResource DialogHint}" Margin="0,6,0,0" />
                        <TextBlock x:Name="SettingsText" Style="{StaticResource DialogHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel Margin="14,12">
                        <TextBlock Text="Command line" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                                   Text="Running the executable with any argument at all runs headless; no arguments opens this window. Operations: --list, --extract, --extract-all, --replace, --recompress, --add, --delete, --rename, --create-from-folder. Run with --help for the full list." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Style="{StaticResource DialogButtonRow}" Margin="0,18,0,0">
            <Button Style="{StaticResource PillButton}" Content="Close" Click="OnClose" IsDefault="True"
                    IsCancel="True" MinWidth="88" />
        </StackPanel>
    </Grid>
</dialogs:ThemedDialog>
