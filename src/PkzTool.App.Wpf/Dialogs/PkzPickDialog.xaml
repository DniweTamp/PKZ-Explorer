<dialogs:ThemedDialog x:Class="PkzTool.App.Wpf.Dialogs.PkzPickDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:PkzTool.App.Wpf.Dialogs"
        Title="Choose a pkz" Width="520" Height="400" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Window}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource DialogTitle}" Text="Add to which pkz?" />

        <TextBlock x:Name="Hint" Grid.Row="1" Style="{StaticResource DialogHint}" Margin="0,8,0,0"
                   Text="Every loaded pkz is listed. The files are added to the one you pick." />

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
            <ListBox x:Name="ArchiveList" Margin="6" Background="Transparent" BorderThickness="0"
                     DisplayMemberPath="." />
        </Border>

        <StackPanel Grid.Row="3" Style="{StaticResource DialogButtonRow}" Margin="0,18,0,0">
            <Button Style="{StaticResource PillButton}" Content="Cancel" Click="OnCancel" IsCancel="True"
                    MinWidth="88" Margin="0,0,8,0" />
            <Button Style="{StaticResource PillButton}" Content="OK" Click="OnOk" IsDefault="True"
                    MinWidth="88" />
        </StackPanel>
    </Grid>
</dialogs:ThemedDialog>
