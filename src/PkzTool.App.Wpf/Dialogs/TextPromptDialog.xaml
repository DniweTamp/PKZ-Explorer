<dialogs:ThemedDialog x:Class="PkzTool.App.Wpf.Dialogs.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:PkzTool.App.Wpf.Dialogs"
        Title="Rename" Width="460" Height="250" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Window}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Headline" Style="{StaticResource DialogTitle}" Text="Rename" />

        <TextBlock x:Name="Hint" Grid.Row="1" Style="{StaticResource DialogHint}" Margin="0,8,0,0" />

        <TextBox x:Name="NameBox" Grid.Row="2" Style="{StaticResource FieldBox}" Margin="0,16,0,0"
                 Height="32" VerticalContentAlignment="Center" FontFamily="Consolas"
                 TextChanged="OnNameChanged" />

        <TextBlock x:Name="ValidationText" Grid.Row="3" Style="{StaticResource DialogHint}"
                   Margin="0,8,0,0" VerticalAlignment="Top" />

        <StackPanel Grid.Row="4" Style="{StaticResource DialogButtonRow}" Margin="0,18,0,0">
            <Button Style="{StaticResource PillButton}" Content="Cancel" Click="OnCancel" IsCancel="True"
                    MinWidth="88" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Style="{StaticResource PillButton}" Content="Rename" Click="OnOk"
                    IsDefault="True" MinWidth="88" />
        </StackPanel>
    </Grid>
</dialogs:ThemedDialog>
