<dialogs:ThemedDialog x:Class="PkzTool.App.Wpf.Dialogs.OodleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:PkzTool.App.Wpf.Dialogs"
        Title="Oodle dll" Width="560" Height="330" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Window}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource DialogTitle}" Text="An Oodle dll is needed" />

        <TextBlock Grid.Row="1" Style="{StaticResource DialogHint}" Margin="0,10,0,0"
                   Text="Oodle Kraken compression needs a 64-bit oo2core_*.dll, which this tool cannot bundle. Point at the copy that came with the game or an emulator install." />

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource FieldBox}" Height="30"
                     VerticalContentAlignment="Center" TextChanged="OnPathChanged" />
            <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="Browse..." Margin="8,0,0,0"
                    Height="30" Click="OnBrowse" />
        </Grid>

        <!-- Detected candidates: what is actually on this machine, so the user need not hunt. -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="Detected" Style="{StaticResource SectionHeader}" />
            <ItemsControl x:Name="CandidateList" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource PillButton}" HorizontalAlignment="Left"
                                Margin="0,0,0,6" Click="OnPickCandidate" Tag="{Binding}"
                                Content="{Binding}" ToolTip="Use this dll" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="4" Style="{StaticResource DialogHint}"
                   VerticalAlignment="Top" Margin="0,6,0,0" />

        <StackPanel Grid.Row="5" Style="{StaticResource DialogButtonRow}" Margin="0,18,0,0">
            <Button Style="{StaticResource PillButton}" Content="Cancel" Click="OnCancel" IsCancel="True"
                    MinWidth="88" Margin="0,0,8,0" />
            <Button x:Name="OkButton" Style="{StaticResource PillButton}" Content="Use this dll"
                    Click="OnOk" IsDefault="True" MinWidth="110" />
        </StackPanel>
    </Grid>
</dialogs:ThemedDialog>
