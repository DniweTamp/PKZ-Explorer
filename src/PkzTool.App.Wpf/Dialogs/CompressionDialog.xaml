<dialogs:ThemedDialog x:Class="PkzTool.App.Wpf.Dialogs.CompressionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:PkzTool.App.Wpf.Dialogs"
        Title="Compression" Width="460" Height="420"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Window}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="Headline" Grid.Row="0" Style="{StaticResource DialogTitle}" Text="Compression" />

        <TextBlock x:Name="Hint" Grid.Row="1" Style="{StaticResource DialogHint}" Margin="0,8,0,0"
                   Text="Every file is stored uncompressed when compression does not shrink it below 90% of its original size." />

        <!-- Compression type -->
        <StackPanel x:Name="TypeList" Grid.Row="2" Margin="0,16,0,0" />

        <!-- Level -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.Muted}" Margin="0,0,10,0" />
            <Slider x:Name="LevelSlider" Grid.Column="1" Style="{StaticResource TimeBarSlider}"
                    Minimum="1" Maximum="22" Value="3" IsSnapToTickEnabled="True" TickFrequency="1"
                    ValueChanged="OnLevelChanged"
                    ToolTip="Codec effort. Higher is slower and usually smaller." />
            <TextBlock x:Name="LevelText" Grid.Column="2" Text="3" MinWidth="34" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextAlignment="Right" FontFamily="Consolas" />
        </Grid>

        <!-- The rule is explained rather than offered as a checkbox: it is the tool's behaviour. -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,16,0,0" VerticalAlignment="Top">
            <StackPanel Margin="14,12">
                <TextBlock Text="Automatic fallback" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="RuleText" Style="{StaticResource DialogHint}" Margin="0,7,0,0"
                           Text="Files that stay at 90% or more of their original size are stored uncompressed, whichever type is chosen here." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" Style="{StaticResource DialogButtonRow}" Margin="0,18,0,0">
            <Button Style="{StaticResource PillButton}" Content="Cancel" Click="OnCancel" IsCancel="True"
                    MinWidth="88" Margin="0,0,8,0" />
            <Button Style="{StaticResource PillButton}" Content="OK" Click="OnOk" IsDefault="True"
                    MinWidth="88" />
        </StackPanel>
    </Grid>
</dialogs:ThemedDialog>
