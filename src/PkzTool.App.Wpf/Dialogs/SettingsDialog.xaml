<dialogs:ThemedDialog x:Class="PkzTool.App.Wpf.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:PkzTool.App.Wpf.Dialogs"
        Title="Settings" Width="560" Height="400"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Window}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource DialogTitle}" Text="Settings" />

        <!-- Oodle -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel Margin="14,12">
                <TextBlock Text="Oodle dll" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                           Text="Needed for Oodle Kraken compression. Never bundled; it is proprietary. Leave empty to auto-detect oo2core*.dll next to the exe and on PATH." />

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OodleBox" Grid.Column="0" Style="{StaticResource FieldBox}" Height="30"
                             VerticalContentAlignment="Center" TextChanged="OnOodleChanged" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource PillButton}"
                            Content="Browse..." Margin="8,0,0,0" Height="30" Click="OnBrowseOodle" />
                </Grid>

                <TextBlock x:Name="OodleStatus" Style="{StaticResource DialogHint}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>

        <!-- Behaviour -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel Margin="14,12">
                <TextBlock Text="Compression defaults" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource DialogHint}" Margin="0,6,0,0"
                           Text="What the Replace, Recompress and Add dialogs start on." />

                <StackPanel x:Name="DefaultTypeList" Orientation="Horizontal" Margin="0,10,0,0" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Level" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Muted}" Margin="0,0,10,0" />
                    <Slider x:Name="LevelSlider" Grid.Column="1" Style="{StaticResource TimeBarSlider}"
                            Minimum="1" Maximum="22" Value="3" IsSnapToTickEnabled="True"
                            ValueChanged="OnLevelChanged" />
                    <TextBlock x:Name="LevelText" Grid.Column="2" Text="3" MinWidth="34" Margin="10,0,0,0"
                               VerticalAlignment="Center" TextAlignment="Right" FontFamily="Consolas" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Where the state lives, so "portable" is verifiable rather than a claim. -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" VerticalAlignment="Top">
            <StackPanel Margin="14,12">
                <TextBlock Text="Settings file" Style="{StaticResource SectionHeader}" />
                <TextBlock x:Name="SettingsPathText" Style="{StaticResource DialogHint}" Margin="0,6,0,0" />
                <TextBlock x:Name="SettingsFallbackText" Style="{StaticResource DialogHint}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Style="{StaticResource DialogButtonRow}" Margin="0,18,0,0">
            <Button Style="{StaticResource PillButton}" Content="Cancel" Click="OnCancel" IsCancel="True"
                    MinWidth="88" Margin="0,0,8,0" />
            <Button Style="{StaticResource PillButton}" Content="OK" Click="OnOk" IsDefault="True"
                    MinWidth="88" />
        </StackPanel>
    </Grid>
</dialogs:ThemedDialog>
