<dialogs:ThemedDialog x:Class="PkzTool.App.Wpf.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:PkzTool.App.Wpf.Dialogs"
        Title="Notice" Width="500" Height="300" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Window}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- Auto, not star: the row must collapse when there is no detail, and the theme sizes the
                 window to its content anyway. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The glyph matches the severity the caller asked for, so a warning still reads as one. -->
        <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.Control}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" VerticalAlignment="Top">
                <TextBlock x:Name="Glyph" Style="{StaticResource IconText}" FontSize="17"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="Heading" Style="{StaticResource DialogTitle}" Margin="12,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="Intro" Grid.Row="1" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text}" />

        <!-- The detail scrolls: a failed load can list many files, and the body must not push the
             buttons off the bottom of the window. Hidden entirely when there is no detail, so a simple
             question does not carry an empty box. -->
        <Border x:Name="DetailCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                <TextBlock x:Name="Detail" TextWrapping="Wrap" FontFamily="Consolas"
                           Foreground="{DynamicResource Brush.Muted}" />
            </ScrollViewer>
        </Border>

        <!-- Three slots, because a yes/no/cancel question needs three answers. The middle one is the
             second answer when there is one ("No"), and hidden otherwise. -->
        <StackPanel Grid.Row="3" Style="{StaticResource DialogButtonRow}" Margin="0,18,0,0">
            <Button x:Name="DismissButton" Style="{StaticResource PillButton}" Content="No"
                    Click="OnNo" MinWidth="88" Margin="0,0,8,0" Visibility="Collapsed" />
            <Button x:Name="CancelButton" Style="{StaticResource PillButton}" Content="Cancel"
                    Click="OnCancel" IsCancel="True" MinWidth="88" Margin="0,0,8,0" />
            <Button x:Name="AcceptButton" Style="{StaticResource PillButton}" Content="OK"
                    Click="OnAccept" IsDefault="True" MinWidth="88" />
        </StackPanel>
    </Grid>
</dialogs:ThemedDialog>
