<dialogs:ThemedDialog x:Class="PkzTool.App.Wpf.Dialogs.OverwriteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:PkzTool.App.Wpf.Dialogs"
        Title="Files already exist" Width="470" Height="270"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Brush.Window}">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource DialogTitle}" Text="Files already exist" />

        <TextBlock x:Name="Body" Grid.Row="1" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text}" />

        <TextBlock Grid.Row="2" Style="{StaticResource DialogHint}" Margin="0,8,0,0"
                   Text="This applies to every file in this operation." />

        <StackPanel Grid.Row="4" Style="{StaticResource DialogButtonRow}" Margin="0,18,0,0">
            <Button Style="{StaticResource PillButton}" Content="Cancel" Click="OnCancel" IsCancel="True"
                    MinWidth="88" Margin="0,0,8,0" />
            <Button Style="{StaticResource PillButton}" Content="Skip existing" Click="OnSkip"
                    MinWidth="112" Margin="0,0,8,0" />
            <Button Style="{StaticResource PillButton}" Content="Overwrite" Click="OnOverwrite"
                    IsDefault="True" MinWidth="96" />
        </StackPanel>
    </Grid>
</dialogs:ThemedDialog>
